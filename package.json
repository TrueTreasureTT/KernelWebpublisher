{
  "name": "kernel-publisher",
  "private": true,
  "version": "1.0.0",
  "description": "A TypeScript cloud website publishing platform.",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "prisma": "^6.14.0",
    "tsx": "^4.19.4",
    "turbo": "^2.5.5",
    "typescript": "^5.9.2"
  }
}
